# Роль текущего сервера: app — приложение, db — PostgreSQL/firewall.
DEPLOY_ROLE=app

# Исходный код. Для штатного развёртывания оставьте ветку main.
REPOSITORY_URL=https://example.com/organization/InventoryAccountment.git
REPOSITORY_BRANCH=main
APP_DIR=/opt/InventoryAccountment

# Системный пользователь и внешняя runtime-конфигурация.
SERVICE_USER=inv_acc
SERVICE_GROUP=inv_acc
SERVICE_HOME=/var/lib/InventoryAccountment
CONFIG_DIR=/etc/InventoryAccountment
RUNTIME_ENV_FILE=/etc/InventoryAccountment/InventoryAccountment.env

# Имена создаваемых systemd-служб.
APP_SERVICE_NAME=InventoryAccountment.service
MIGRATION_SERVICE_NAME=InventoryAccountment-migrate.service
FRONTEND_SERVICE_NAME=InventoryAccountment-frontend.service

# Настройки API. Пароль в URL должен быть percent-encoded.
DATABASE_URL=postgresql+psycopg2://inventory:CHANGE_ME@10.20.0.20:5432/inventory
APP_ENV=production
APP_DEBUG=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend доступен клиентам, API остаётся на loopback и проксируется Vite.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=4173

# UFW. Сначала задайте реальную сеть администраторов, чтобы не потерять SSH.
ENABLE_FIREWALL=true
SSH_NETWORK=10.10.1.0/24
SSH_PORT=22
CLIENT_NETWORK=10.10.0.0/24
EXPOSE_BACKEND=false

# Для DEPLOY_ROLE=db укажите IP сервера приложения. Порт БД будет разрешён
# только этому адресу; PostgreSQL дополнительно настройте через pg_hba.conf.
APP_SERVER_IP=10.20.0.10
DB_PORT=5432

# Управление миграциями и версиями инструментов.
RUN_MIGRATIONS=true
NODE_MAJOR=22
NODE_MIN_VERSION=22.13.0
PNPM_VERSION=11.19.0
