# Ключи рабочего Compose: локальный .env либо внешний файл, выбранный ENV_FILE.
# Путь задавайте в окружении запуска, не в этом файле.
# Не используйте примерный пароль для публичного развёртывания.
POSTGRES_USER=inventory_app
POSTGRES_PASSWORD=local_inventory_password
POSTGRES_DB=inventory
APP_PORT=8010
FRONTEND_PORT=5180
