# Подключение к PostgreSQL из docker-compose.yaml
DATABASE_URL=postgresql+psycopg2://inventory_app:change-me-local@127.0.0.1:5433/inventory
POSTGRES_USER=inventory_app
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=inventory
POSTGRES_PORT=5433

# Настройки приложения для локальной разработки
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
