FROM 192.168.56.111:5000/astral-sh/uv:0.9.5@sha256:f459f6f73a8c4ef5d69f4e6fbbdb8af751d6fa40ec34b39a1ab469acd6e289b7 AS uv

FROM 192.168.56.111:5000/ubi9/python-312:1@sha256:19e1e927138b40454858f297884c2c4e2f13f5ba95b3f55faea174d3cbb57067 AS backend-test
USER 0
COPY --from=uv /uv /usr/local/bin/uv
RUN mkdir -p /workspace/backend && chmod 1777 /workspace/backend
WORKDIR /workspace/backend
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    UV_CACHE_DIR=/opt/app-root/src/.cache/uv PATH="/workspace/backend/.venv/bin:$PATH"
COPY --chown=1001:0 backend/pyproject.toml backend/uv.lock ./
USER 1001
RUN --mount=type=cache,target=/opt/app-root/src/.cache/uv,uid=1001,gid=0,sharing=locked uv sync --locked --extra dev --no-install-project --python /usr/bin/python3.12
COPY --chown=1001:0 backend/app ./app
RUN --mount=type=cache,target=/opt/app-root/src/.cache/uv,uid=1001,gid=0,sharing=locked uv sync --locked --extra dev --python /usr/bin/python3.12
COPY --chown=1001:0 backend/alembic.ini ./alembic.ini
COPY --chown=1001:0 backend/alembic ./alembic
COPY --chown=1001:0 backend/tests ./tests
ENTRYPOINT []
CMD ["python", "tests/main.py"]
