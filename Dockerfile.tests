FROM node:24.21.0-bookworm-slim AS node
FROM zricethezav/gitleaks:v8.21.2 AS gitleaks
FROM aquasec/trivy:0.56.2 AS trivy
FROM python:3.11-slim-trixie

RUN apt-get update && apt-get install -y --no-install-recommends make git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

COPY vendor/pnpm-11.19.0.tgz /tmp/pnpm-11.19.0.tgz

RUN echo "7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce  /tmp/pnpm-11.19.0.tgz" | sha512sum -c - \
    && ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install --global --offline /tmp/pnpm-11.19.0.tgz \
    && pnpm --version \
    && python -m pip install --no-cache-dir uv==0.5.29 \
    && rm /tmp/pnpm-11.19.0.tgz

ARG LOCAL_UID=1000
ARG LOCAL_GID=1000
RUN test "$LOCAL_UID" -gt 0 && test "$LOCAL_GID" -gt 0 && \
    groupadd --gid "$LOCAL_GID" app && useradd --uid "$LOCAL_UID" --gid app --create-home app && \
    mkdir -p /app/reports && chown app:app /app /app/reports
ENV HOME=/home/app
USER app
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_OPTIONS="--dns-result-order=ipv4first"
COPY --chown=app:app pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,id=inventory-uv-${LOCAL_UID}-${LOCAL_GID},target=/home/app/.cache/uv,uid=${LOCAL_UID},gid=${LOCAL_GID} uv sync --frozen --extra dev --no-install-project
COPY --chown=app:app frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./frontend/
RUN --mount=type=cache,id=inventory-pnpm-${LOCAL_UID}-${LOCAL_GID},target=/app/.pnpm-store,uid=${LOCAL_UID},gid=${LOCAL_GID} \
    --mount=type=cache,id=inventory-pnpm-metadata-${LOCAL_UID}-${LOCAL_GID},target=/home/app/.cache/pnpm,uid=${LOCAL_UID},gid=${LOCAL_GID} \
    pnpm --dir frontend install \
      --frozen-lockfile \
      --store-dir /app/.pnpm-store \
      --network-concurrency=4 \
      --prefer-offline
COPY --chown=app:app app ./app
COPY --chown=app:app alembic ./alembic
COPY --chown=app:app alembic.ini Makefile ./
COPY --chown=app:app tests ./tests
COPY --chown=app:app scripts ./scripts
COPY --chown=app:app frontend/src ./frontend/src
COPY --chown=app:app frontend/index.html frontend/vite.config.ts frontend/tsconfig.json frontend/tsconfig.app.json frontend/tsconfig.node.json ./frontend/
COPY --chown=app:app frontend/eslint.config.js frontend/prettier.config.mjs frontend/.prettierignore frontend/.gitignore frontend/README.md ./frontend/
RUN --mount=type=cache,id=inventory-uv-${LOCAL_UID}-${LOCAL_GID},target=/home/app/.cache/uv,uid=${LOCAL_UID},gid=${LOCAL_GID} uv sync --frozen --extra dev
COPY --from=gitleaks /usr/bin/gitleaks /usr/local/bin/gitleaks
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
CMD ["make", "-f", "scripts/test-runner.mk", "test"]
