# Контекст содержит только исходники, необходимые Dockerfile.
**
!Dockerfile
!backend/
!backend/pyproject.toml
!backend/uv.lock
!backend/alembic.ini
!backend/app/
!backend/app/**
!backend/alembic/
!backend/alembic/**
!frontend/
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/pnpm-workspace.yaml
!frontend/index.html
!frontend/vite.config.ts
!frontend/eslint.config.js
!frontend/prettier.config.mjs
!frontend/.prettierignore
!frontend/tsconfig*.json
!frontend/src/
!frontend/src/**

**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/node_modules
**/.pnpm-store
**/secrets
**/*.key
**/*.pem
**/*.dump
**/*.backup
